@startchen

' Agentic Workflow Generator
' Target conceptual domain model
'
' Design principles:
' - Agent profiles and skill recommendations are reusable defaults.
' - Agent instances are the concrete workers generated by a bundle.
' - Role bindings are authoritative for role-specific capabilities, skills,
'   artifacts, responsibilities, and guardrails.
' - An agent instance owns one effective permission profile and materializes
'   the union of requirements from all assigned role bindings.
' - A role binding is either a state owner or the workflow controller.
' - Separation of duties is an explicit bundle policy.
' - Workflow execution remains fail-closed.

entity "Setup" as SETUP {
  name : STRING <<key>>
  version : STRING
  mode : STRING
  description : STRING
}

entity "Setup question" as SETUP_QUESTION <<weak>> {
  id : STRING <<key>>
  prompt : STRING
}

entity "Setup option" as SETUP_OPTION <<weak>> {
  value : STRING <<key>>
  label : STRING
  classification : STRING
  reason : STRING
}

entity "Bundle" as BUNDLE {
  name : STRING <<key>>
  version : STRING
  description : STRING
}

entity "Profile" as PROFILE {
  name : STRING <<key>>
  version : STRING
  description : STRING
}

entity "Workflow" as WORKFLOW {
  name : STRING <<key>>
  version : STRING
  failClosed : BOOLEAN
}

entity "Workflow state" as WORKFLOW_STATE <<weak>> {
  name : STRING <<key>>
  terminal : BOOLEAN
}

entity "Transition" as TRANSITION <<weak>> {
  id : STRING <<key>>
  event : STRING
}

entity "Gate" as GATE <<weak>> {
  name : STRING <<key>>
  blocking : BOOLEAN
}

entity "Agent profile" as AGENT_PROFILE {
  name : STRING <<key>>
  version : STRING
  role : STRING
  description : STRING
  recommendedResponsibility : STRING <<multi>>
  defaultGuardrail : STRING <<multi>>
}

entity "Agent instance" as AGENT_INSTANCE <<weak>> {
  id : STRING <<key>>
  displayName : STRING
  sharedContextPolicy : STRING
}

entity "Role binding" as ROLE_BINDING <<weak>> {
  roleName : STRING <<key>>
  bindingType : STRING
  responsibility : STRING <<multi>>
  guardrail : STRING <<multi>>
}

entity "Separation policy" as SEPARATION_POLICY <<weak>> {
  id : STRING <<key>>
  mode : STRING
  requireDistinctInstances : BOOLEAN
  reason : STRING
}

entity "Skill" as SKILL {
  name : STRING <<key>>
  version : STRING
  contentPath : STRING
  contextBudget : INTEGER
}

entity "Capability" as CAPABILITY {
  name : STRING <<key>>
  description : STRING
}

entity "Artifact contract" as ARTIFACT_CONTRACT {
  type : STRING <<key>>
  version : STRING
  pathPattern : STRING
  allowedStatus : STRING <<multi>>
}

entity "Permission profile" as PERMISSION_PROFILE {
  name : STRING <<key>>
  read : BOOLEAN
  write : BOOLEAN
  edit : BOOLEAN
  bash : STRING
}

entity "Target adapter" as TARGET_ADAPTER {
  name : STRING <<key>>
  version : STRING
  description : STRING
}

relationship "contains question" as HAS_QUESTION <<identifying>> {
}

relationship "contains option" as HAS_OPTION <<identifying>> {
}

relationship "uses default bundle" as DEFAULT_BUNDLE {
}

relationship "selects bundle" as SELECTS_BUNDLE {
}

relationship "selects profile" as SELECTS_PROFILE {
}

relationship "selects workflow" as SELECTS_WORKFLOW {
}

relationship "starts at" as STARTS_AT {
}

relationship "defaults failure to" as DEFAULTS_FAILURE_TO {
}

relationship "recommends workflow" as RECOMMENDS_WORKFLOW {
  advisory : BOOLEAN
}

relationship "compatible with workflow" as COMPATIBLE_WORKFLOW {
  advisory : BOOLEAN
}

relationship "recommends agent profile" as PROFILE_RECOMMENDS_AGENT {
  advisory : BOOLEAN
}

relationship "recommends capability" as PROFILE_RECOMMENDS_CAPABILITY {
  advisory : BOOLEAN
}

relationship "contains state" as CONTAINS_STATE <<identifying>> {
}

relationship "contains transition" as CONTAINS_TRANSITION <<identifying>> {
}

relationship "starts from" as FROM_STATE {
}

relationship "routes to" as TO_STATE {
}

relationship "has gate" as HAS_GATE <<identifying>> {
}

relationship "contains agent instance" as HAS_AGENT_INSTANCE <<identifying>> {
}

relationship "instantiates profile" as INSTANTIATES_PROFILE {
}

relationship "contains role binding" as HAS_ROLE_BINDING <<identifying>> {
}

relationship "binds workflow state" as BINDS_STATE {
}

relationship "controls workflow" as CONTROLS_WORKFLOW {
}

relationship "assigns agent instance" as ASSIGNS_INSTANCE {
}

relationship "requires capability" as BINDING_REQUIRES_CAPABILITY {
  authoritative : BOOLEAN
}

relationship "selects skill" as BINDING_SELECTS_SKILL {
  authoritative : BOOLEAN
}

relationship "uses effective permission" as INSTANCE_USES_PERMISSION {
  authoritative : BOOLEAN
}

relationship "produces artifact" as BINDING_PRODUCES_ARTIFACT {
  authoritative : BOOLEAN
}

relationship "owns gate" as OWNS_GATE {
}

relationship "contains separation policy" as HAS_SEPARATION_POLICY <<identifying>> {
}

relationship "constrains role binding" as CONSTRAINS_BINDING {
}

relationship "includes skill" as BUNDLE_INCLUDES_SKILL {
}

relationship "includes artifact" as BUNDLE_INCLUDES_ARTIFACT {
}

relationship "enables target" as ENABLES_TARGET {
}

relationship "requires capability" as GATE_REQUIRES_CAPABILITY {
}

relationship "requires artifact" as GATE_REQUIRES_ARTIFACT {
}

relationship "provides capability" as PROVIDES_CAPABILITY {
}

relationship "requires capability" as SKILL_REQUIRES_CAPABILITY {
}

relationship "recommends agent profile" as SKILL_RECOMMENDS_AGENT {
  advisory : BOOLEAN
}

relationship "recommends capability" as AGENT_RECOMMENDS_CAPABILITY {
  advisory : BOOLEAN
}

relationship "defaults to permission" as DEFAULT_PERMISSION {
  advisory : BOOLEAN
}

relationship "maps permission" as MAPS_PERMISSION {
  targetPolicy : STRING
}

HAS_QUESTION =1= SETUP
HAS_QUESTION =N= SETUP_QUESTION

HAS_OPTION =1= SETUP_QUESTION
HAS_OPTION =N= SETUP_OPTION

DEFAULT_BUNDLE -(1,1)- SETUP
DEFAULT_BUNDLE -(0,N)- BUNDLE

SELECTS_BUNDLE -(0,1)- SETUP_OPTION
SELECTS_BUNDLE -(0,N)- BUNDLE

SELECTS_PROFILE -(1,1)- BUNDLE
SELECTS_PROFILE -(0,N)- PROFILE

SELECTS_WORKFLOW -(1,1)- BUNDLE
SELECTS_WORKFLOW -(0,N)- WORKFLOW

STARTS_AT -(1,1)- WORKFLOW
STARTS_AT -(0,1)- WORKFLOW_STATE

DEFAULTS_FAILURE_TO -(1,1)- WORKFLOW
DEFAULTS_FAILURE_TO -(0,1)- WORKFLOW_STATE

RECOMMENDS_WORKFLOW -(0,N)- PROFILE
RECOMMENDS_WORKFLOW -(0,N)- WORKFLOW

COMPATIBLE_WORKFLOW -(0,N)- PROFILE
COMPATIBLE_WORKFLOW -(0,N)- WORKFLOW

PROFILE_RECOMMENDS_AGENT -(0,N)- PROFILE
PROFILE_RECOMMENDS_AGENT -(0,N)- AGENT_PROFILE

PROFILE_RECOMMENDS_CAPABILITY -(0,N)- PROFILE
PROFILE_RECOMMENDS_CAPABILITY -(0,N)- CAPABILITY

CONTAINS_STATE =1= WORKFLOW
CONTAINS_STATE =N= WORKFLOW_STATE

CONTAINS_TRANSITION =1= WORKFLOW
CONTAINS_TRANSITION =N= TRANSITION

FROM_STATE -(1,1)- TRANSITION
FROM_STATE -(0,N)- WORKFLOW_STATE

TO_STATE -(1,1)- TRANSITION
TO_STATE -(0,N)- WORKFLOW_STATE

HAS_GATE -1- WORKFLOW_STATE
HAS_GATE =1= GATE

HAS_AGENT_INSTANCE =1= BUNDLE
HAS_AGENT_INSTANCE =N= AGENT_INSTANCE

INSTANTIATES_PROFILE -(1,1)- AGENT_INSTANCE
INSTANTIATES_PROFILE -(0,N)- AGENT_PROFILE

HAS_ROLE_BINDING =1= BUNDLE
HAS_ROLE_BINDING =N= ROLE_BINDING

BINDS_STATE -(0,1)- ROLE_BINDING
BINDS_STATE -(0,1)- WORKFLOW_STATE

CONTROLS_WORKFLOW -(0,1)- ROLE_BINDING
CONTROLS_WORKFLOW -(1,1)- WORKFLOW

ASSIGNS_INSTANCE -(1,N)- AGENT_INSTANCE
ASSIGNS_INSTANCE -(1,1)- ROLE_BINDING

BINDING_REQUIRES_CAPABILITY -(1,N)- ROLE_BINDING
BINDING_REQUIRES_CAPABILITY -(0,N)- CAPABILITY

BINDING_SELECTS_SKILL -(1,N)- ROLE_BINDING
BINDING_SELECTS_SKILL -(0,N)- SKILL

INSTANCE_USES_PERMISSION -(1,1)- AGENT_INSTANCE
INSTANCE_USES_PERMISSION -(0,N)- PERMISSION_PROFILE

BINDING_PRODUCES_ARTIFACT -(0,N)- ROLE_BINDING
BINDING_PRODUCES_ARTIFACT -(0,N)- ARTIFACT_CONTRACT

OWNS_GATE -(0,1)- ROLE_BINDING
OWNS_GATE -(1,1)- GATE

HAS_SEPARATION_POLICY -1- BUNDLE
HAS_SEPARATION_POLICY =N= SEPARATION_POLICY

CONSTRAINS_BINDING -(2,N)- SEPARATION_POLICY
CONSTRAINS_BINDING -(0,N)- ROLE_BINDING

BUNDLE_INCLUDES_SKILL -(1,N)- BUNDLE
BUNDLE_INCLUDES_SKILL -(0,N)- SKILL

BUNDLE_INCLUDES_ARTIFACT -(1,N)- BUNDLE
BUNDLE_INCLUDES_ARTIFACT -(0,N)- ARTIFACT_CONTRACT

ENABLES_TARGET -(1,N)- BUNDLE
ENABLES_TARGET -(0,N)- TARGET_ADAPTER

GATE_REQUIRES_CAPABILITY -(1,N)- GATE
GATE_REQUIRES_CAPABILITY -(0,N)- CAPABILITY

GATE_REQUIRES_ARTIFACT -(1,N)- GATE
GATE_REQUIRES_ARTIFACT -(0,N)- ARTIFACT_CONTRACT

PROVIDES_CAPABILITY -(1,N)- SKILL
PROVIDES_CAPABILITY -(1,1)- CAPABILITY

SKILL_REQUIRES_CAPABILITY -(0,N)- SKILL
SKILL_REQUIRES_CAPABILITY -(0,N)- CAPABILITY

SKILL_RECOMMENDS_AGENT -(0,N)- SKILL
SKILL_RECOMMENDS_AGENT -(0,N)- AGENT_PROFILE

AGENT_RECOMMENDS_CAPABILITY -(0,N)- AGENT_PROFILE
AGENT_RECOMMENDS_CAPABILITY -(0,N)- CAPABILITY

DEFAULT_PERMISSION -(1,1)- AGENT_PROFILE
DEFAULT_PERMISSION -(0,N)- PERMISSION_PROFILE

MAPS_PERMISSION -(1,N)- TARGET_ADAPTER
MAPS_PERMISSION -(1,N)- PERMISSION_PROFILE

' Invariants not expressible by cardinality alone:
' - Every non-terminal workflow state has exactly one state-owner binding.
' - Terminal workflow states have no role binding and no gate.
' - Every workflow has exactly one controller binding.
' - Every role binding is either a state owner or a controller, never both.
' - One agent instance may serve several role bindings.
' - The instance permission profile must satisfy every assigned binding.
' - Binding-selected skills must be included by the owning bundle.
' - A start or failure state must belong to the related workflow.

@endchen
