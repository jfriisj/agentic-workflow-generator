@startchen

' Agentic Workflow Generator

' Capabilities, artifacts and targets context

'

' Full entities belong to this bounded context.

' Reference entities are defined authoritatively elsewhere.

entity "Skill" as SKILL {
  name : STRING <<key>>
  version : STRING
  contentPath : STRING
  contextBudget : INTEGER
}

entity "Capability" as CAPABILITY {
  name : STRING <<key>>
  description : STRING
}

entity "Artifact contract" as ARTIFACT_CONTRACT {
  type : STRING <<key>>
  version : STRING
  pathPattern : STRING
  allowedStatus : STRING <<multi>>
}

entity "Permission profile" as PERMISSION_PROFILE {
  name : STRING <<key>>
  read : BOOLEAN
  write : BOOLEAN
  edit : BOOLEAN
  bash : STRING
}

entity "Target adapter" as TARGET_ADAPTER {
  name : STRING <<key>>
  version : STRING
  description : STRING
  outputPath : STRING <<multi>>
  ownedPath : STRING <<multi>>
}

entity "Bundle" as BUNDLE <<reference>> {
  name : STRING <<key>>
}

entity "Role binding" as ROLE_BINDING <<reference>> {
  roleName : STRING <<key>>
}

entity "Agent profile" as AGENT_PROFILE <<reference>> {
  name : STRING <<key>>
}

relationship "requires capability" as BINDING_REQUIRES_CAPABILITY {
  authoritative : BOOLEAN
}

relationship "selects skill" as BINDING_SELECTS_SKILL {
  authoritative : BOOLEAN
}

relationship "produces artifact" as BINDING_PRODUCES_ARTIFACT {
  authoritative : BOOLEAN
}

relationship "includes skill" as BUNDLE_INCLUDES_SKILL {
}

relationship "includes artifact" as BUNDLE_INCLUDES_ARTIFACT {
}

relationship "enables target" as ENABLES_TARGET {
}

relationship "provides capability" as PROVIDES_CAPABILITY {
}

relationship "requires capability" as SKILL_REQUIRES_CAPABILITY {
}

relationship "recommends agent profile" as SKILL_RECOMMENDS_AGENT {
  advisory : BOOLEAN
}

relationship "recommends capability" as AGENT_RECOMMENDS_CAPABILITY {
  advisory : BOOLEAN
}

relationship "maps permission" as MAPS_PERMISSION {
  targetPolicy : STRING
}

BINDING_REQUIRES_CAPABILITY -(1,N)- ROLE_BINDING
BINDING_REQUIRES_CAPABILITY -(0,N)- CAPABILITY
BINDING_SELECTS_SKILL -(1,N)- ROLE_BINDING
BINDING_SELECTS_SKILL -(0,N)- SKILL
BINDING_PRODUCES_ARTIFACT -(0,N)- ROLE_BINDING
BINDING_PRODUCES_ARTIFACT -(0,N)- ARTIFACT_CONTRACT
BUNDLE_INCLUDES_SKILL -(1,N)- BUNDLE
BUNDLE_INCLUDES_SKILL -(0,N)- SKILL
BUNDLE_INCLUDES_ARTIFACT -(1,N)- BUNDLE
BUNDLE_INCLUDES_ARTIFACT -(0,N)- ARTIFACT_CONTRACT
ENABLES_TARGET -(1,N)- BUNDLE
ENABLES_TARGET -(0,N)- TARGET_ADAPTER
PROVIDES_CAPABILITY -(1,N)- SKILL
PROVIDES_CAPABILITY -(1,1)- CAPABILITY
SKILL_REQUIRES_CAPABILITY -(0,N)- SKILL
SKILL_REQUIRES_CAPABILITY -(0,N)- CAPABILITY
SKILL_RECOMMENDS_AGENT -(0,N)- SKILL
SKILL_RECOMMENDS_AGENT -(0,N)- AGENT_PROFILE
AGENT_RECOMMENDS_CAPABILITY -(0,N)- AGENT_PROFILE
AGENT_RECOMMENDS_CAPABILITY -(0,N)- CAPABILITY
MAPS_PERMISSION -(1,N)- TARGET_ADAPTER
MAPS_PERMISSION -(1,N)- PERMISSION_PROFILE

' Invariants not expressible by cardinality alone:

' - Role bindings own required capabilities.

' - Role bindings explicitly select skills.

' - Selected skills belong to the owning bundle.

' - Selected skills provide every required capability.

' - Artifact production belongs to role bindings.

' - Every effective permission maps through every enabled target.

' - Target-specific behavior belongs to renderer code.

@endchen
