{
  "name": "lean-delivery",
  "description": "Compact delivery bundle for focused changes with requirements, implementation, testing, code review, and fail-closed routing.",
  "version": "0.3.0",
  "profile": "lean-delivery",
  "workflow": "lean-delivery",
  "agentInstances": [
    {
      "id": "requirements-worker",
      "profile": "Requirements",
      "displayName": "Requirements",
      "permissionProfile": "read-only",
      "sharedContextPolicy": "shared-with-assigned-bindings"
    },
    {
      "id": "implementation-worker",
      "profile": "Implementer",
      "displayName": "Implementer",
      "permissionProfile": "implementation",
      "sharedContextPolicy": "shared-with-assigned-bindings"
    },
    {
      "id": "test-runner",
      "profile": "TestRunner",
      "displayName": "TestRunner",
      "permissionProfile": "test-runner",
      "sharedContextPolicy": "shared-with-assigned-bindings"
    },
    {
      "id": "code-review-worker",
      "profile": "CodeReviewer",
      "displayName": "CodeReviewer",
      "permissionProfile": "read-only",
      "sharedContextPolicy": "shared-with-assigned-bindings"
    },
    {
      "id": "workflow-controller",
      "profile": "Orchestrator",
      "displayName": "Orchestrator",
      "permissionProfile": "read-only",
      "sharedContextPolicy": "shared-with-assigned-bindings"
    }
  ],
  "roleBindings": [
    {
      "roleName": "requirements",
      "bindingType": "state-owner",
      "agentInstance": "requirements-worker",
      "workflowState": "Requirements",
      "requiredCapabilities": [
        "requirements.elicit",
        "requirements.define-acceptance-criteria"
      ],
      "selectedSkills": [
        "requirements-analysis"
      ],
      "produces": [
        "Requirements"
      ],
      "inputArtifacts": [],
      "responsibilities": [
        "Clarify the problem statement",
        "Identify explicit and implicit requirements",
        "Document assumptions and constraints",
        "Define measurable acceptance criteria",
        "Create requirements artifacts"
      ],
      "guardrails": [
        "Design implementation details",
        "Approve release",
        "Skip unresolved assumptions",
        "Change workflow routing"
      ],
      "workflowGate": "requirements-review"
    },
    {
      "roleName": "implementation",
      "bindingType": "state-owner",
      "agentInstance": "implementation-worker",
      "workflowState": "Implementer",
      "requiredCapabilities": [
        "implementation.code",
        "implementation.refactor",
        "implementation.update-tests"
      ],
      "selectedSkills": [
        "implementation-engineering"
      ],
      "produces": [
        "ImplementationReport"
      ],
      "inputArtifacts": [
        {
          "artifactType": "Requirements",
          "roleBinding": "requirements"
        }
      ],
      "responsibilities": [
        "Modify product code",
        "Update tests",
        "Keep implementation aligned with approved artifacts",
        "Create implementation report"
      ],
      "guardrails": [
        "Change workflow routing",
        "Self-approve implementation",
        "Skip validation evidence"
      ],
      "workflowGate": "implementation-complete"
    },
    {
      "roleName": "test-execution",
      "bindingType": "state-owner",
      "agentInstance": "test-runner",
      "workflowState": "TestRunner",
      "requiredCapabilities": [
        "test.run",
        "test.report",
        "test.diagnose-failure"
      ],
      "selectedSkills": [
        "test-execution"
      ],
      "produces": [
        "TestReport"
      ],
      "inputArtifacts": [
        {
          "artifactType": "ImplementationReport",
          "roleBinding": "implementation"
        },
        {
          "artifactType": "Requirements",
          "roleBinding": "requirements"
        }
      ],
      "responsibilities": [
        "Run relevant tests",
        "Collect validation output",
        "Diagnose test failures",
        "Create test report"
      ],
      "guardrails": [
        "Approve code quality",
        "Change requirements",
        "Hide failing validation"
      ],
      "workflowGate": "test-review"
    },
    {
      "roleName": "code-review",
      "bindingType": "state-owner",
      "agentInstance": "code-review-worker",
      "workflowState": "CodeReviewer",
      "requiredCapabilities": [
        "review.clean-code",
        "review.tests",
        "review.security"
      ],
      "selectedSkills": [
        "code-review-clean-code",
        "code-review-tests",
        "security-review"
      ],
      "produces": [
        "CodeReview"
      ],
      "inputArtifacts": [
        {
          "artifactType": "Requirements",
          "roleBinding": "requirements"
        },
        {
          "artifactType": "TestReport",
          "roleBinding": "test-execution"
        }
      ],
      "responsibilities": [
        "Review changed code",
        "Check maintainability and readability",
        "Check test coverage evidence",
        "Create code review artifact",
        "Record failed review disposition and recommend the configured remediation target"
      ],
      "guardrails": [
        "Implement feature behavior",
        "Approve release",
        "Change workflow routing",
        "Perform workflow transitions"
      ],
      "workflowGate": "code-review"
    },
    {
      "roleName": "workflow-controller",
      "bindingType": "workflow-controller",
      "agentInstance": "workflow-controller",
      "requiredCapabilities": [
        "workflow.route",
        "workflow.validate-state",
        "workflow.handoff"
      ],
      "selectedSkills": [
        "workflow-routing"
      ],
      "produces": [],
      "inputArtifacts": [],
      "responsibilities": [
        "Read workflow state",
        "Interpret gate results",
        "Route work only through a unique configured transition",
        "Stop on missing evidence",
        "Stop without transition when routing is missing or ambiguous",
        "Keep workflow execution fail-closed"
      ],
      "guardrails": [
        "Implement product code",
        "Override gates without evidence",
        "Perform domain-specific review",
        "Invent workflow transitions",
        "Route work without a unique validated transition"
      ]
    }
  ],
  "separationPolicies": [
    {
      "id": "role-independence",
      "mode": "required",
      "roleBindings": [
        "requirements",
        "implementation",
        "test-execution",
        "code-review",
        "workflow-controller"
      ],
      "requireDistinctInstances": true,
      "reason": "This bundle requires independent workers for each workflow responsibility and routing authority."
    }
  ],
  "skills": [
    "code-review-clean-code",
    "code-review-tests",
    "implementation-engineering",
    "requirements-analysis",
    "security-review",
    "test-execution",
    "workflow-routing"
  ],
  "artifacts": [
    "CodeReview",
    "ImplementationReport",
    "Requirements",
    "TestReport"
  ],
  "targets": [
    "opencode",
    "vscode-copilot"
  ]
}
