{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/agentic/artifacts/a-i-evaluation-report.schema.json",
  "title": "AIEvaluationReport Artifact Contract",
  "type": "object",
  "required": [
    "type",
    "version",
    "description",
    "pathPattern",
    "status",
    "provenance",
    "revision",
    "statusInvariants",
    "statusSemantics",
    "allowedStatuses",
    "requiredHeadings"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "AIEvaluationReport"
    },
    "version": {
      "type": "string",
      "const": "0.6.0"
    },
    "description": {
      "type": "string",
      "const": "Artifact contract for evidence-based AI application quality, safety, and operational evaluation."
    },
    "pathPattern": {
      "type": "string",
      "const": "agent-output/ai-evaluation-report/*.md"
    },
    "status": {
      "type": "object",
      "required": [
        "heading",
        "pattern"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "const": "## Status"
        },
        "pattern": {
          "type": "string",
          "const": "PASS|FAIL|BLOCKED"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "heading",
        "requiredIdentities"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "const": "## Provenance"
        },
        "requiredIdentities": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "const": "artifactType"
            },
            {
              "type": "string",
              "const": "artifactVersion"
            },
            {
              "type": "string",
              "const": "workflow"
            },
            {
              "type": "string",
              "const": "workflowVersion"
            },
            {
              "type": "string",
              "const": "roleBinding"
            },
            {
              "type": "string",
              "const": "agentInstance"
            }
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true
        }
      }
    },
    "revision": {
      "type": "object",
      "required": [
        "heading",
        "pattern"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "const": "## Revision"
        },
        "pattern": {
          "type": "string",
          "const": "^[1-9][0-9]*$"
        }
      }
    },
    "statusInvariants": {
      "type": "object",
      "required": [
        "passRequiresCompleteEvidence",
        "passForbidsDemonstratedNonconformance",
        "failRequiresDemonstratedNonconformance",
        "blockedRequiresUnavailablePrerequisite"
      ],
      "additionalProperties": false,
      "properties": {
        "passRequiresCompleteEvidence": {
          "const": true
        },
        "passForbidsDemonstratedNonconformance": {
          "const": true
        },
        "failRequiresDemonstratedNonconformance": {
          "const": true
        },
        "blockedRequiresUnavailablePrerequisite": {
          "const": true
        }
      }
    },
    "statusSemantics": {
      "type": "object",
      "required": [
        "passDefinition",
        "failDefinition",
        "blockedDefinition",
        "mixedConditionRule"
      ],
      "additionalProperties": false,
      "properties": {
        "passDefinition": {
          "type": "string",
          "const": "Every required AI evaluation criterion within the declared scope is supported by reproducible evidence and satisfies its declared threshold or acceptance condition; required datasets, scenarios, baselines, safety checks, failure-mode checks, and operational evidence are present when applicable; and no required evaluated scenario demonstrates unacceptable behavior."
        },
        "failDefinition": {
          "type": "string",
          "const": "Reproducible evidence demonstrates that at least one required quality, safety, failure-mode, or operational criterion or threshold is not satisfied."
        },
        "blockedDefinition": {
          "type": "string",
          "const": "Required evidence, dataset, scenario, baseline, threshold, evaluation condition, environment, or other prerequisite necessary to evaluate a required criterion is unavailable, missing, or unverifiable."
        },
        "mixedConditionRule": {
          "type": "string",
          "const": "FAIL_ON_DEMONSTRATED_NONCONFORMANCE"
        }
      }
    },
    "allowedStatuses": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "const": "PASS"
        },
        {
          "type": "string",
          "const": "FAIL"
        },
        {
          "type": "string",
          "const": "BLOCKED"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true
    },
    "requiredHeadings": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "const": "# AI Evaluation Report"
        },
        {
          "type": "string",
          "const": "## Status"
        },
        {
          "type": "string",
          "const": "## Provenance"
        },
        {
          "type": "string",
          "const": "## Revision"
        },
        {
          "type": "string",
          "const": "## Summary"
        },
        {
          "type": "string",
          "const": "## Evaluation Scope"
        },
        {
          "type": "string",
          "const": "## Evaluation Data and Scenarios"
        },
        {
          "type": "string",
          "const": "## Metrics, Thresholds, and Baselines"
        },
        {
          "type": "string",
          "const": "## Results"
        },
        {
          "type": "string",
          "const": "## Safety and Failure Analysis"
        },
        {
          "type": "string",
          "const": "## Operational Evidence"
        },
        {
          "type": "string",
          "const": "## Known Limitations"
        },
        {
          "type": "string",
          "const": "## Required Fixes"
        },
        {
          "type": "string",
          "const": "## Handoff Target"
        }
      ],
      "items": false,
      "minItems": 14,
      "maxItems": 14,
      "uniqueItems": true
    }
  }
}
