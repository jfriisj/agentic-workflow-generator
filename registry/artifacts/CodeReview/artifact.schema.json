{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/agentic/artifacts/code-review.schema.json",
  "title": "CodeReview Artifact Contract",
  "type": "object",
  "required": [
    "type",
    "version",
    "description",
    "pathPattern",
    "status",
    "provenance",
    "revision",
    "statusInvariants",
    "statusSemantics",
    "allowedStatuses",
    "requiredHeadings"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "CodeReview"
    },
    "version": {
      "type": "string",
      "const": "0.6.0"
    },
    "description": {
      "type": "string",
      "const": "Artifact contract for code review gate output."
    },
    "pathPattern": {
      "type": "string",
      "const": "agent-output/code-review/*.md"
    },
    "status": {
      "type": "object",
      "required": [
        "heading",
        "pattern"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "const": "## Status"
        },
        "pattern": {
          "type": "string",
          "const": "PASS|FAIL|BLOCKED"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "heading",
        "requiredIdentities"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "const": "## Provenance"
        },
        "requiredIdentities": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "const": "artifactType"
            },
            {
              "type": "string",
              "const": "artifactVersion"
            },
            {
              "type": "string",
              "const": "workflow"
            },
            {
              "type": "string",
              "const": "workflowVersion"
            },
            {
              "type": "string",
              "const": "roleBinding"
            },
            {
              "type": "string",
              "const": "agentInstance"
            }
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true
        }
      }
    },
    "revision": {
      "type": "object",
      "required": [
        "heading",
        "pattern"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "const": "## Revision"
        },
        "pattern": {
          "type": "string",
          "const": "^[1-9][0-9]*$"
        }
      }
    },
    "statusInvariants": {
      "type": "object",
      "required": [
        "passRequiresCompleteEvidence",
        "passForbidsDemonstratedNonconformance",
        "failRequiresDemonstratedNonconformance",
        "blockedRequiresUnavailablePrerequisite"
      ],
      "additionalProperties": false,
      "properties": {
        "passRequiresCompleteEvidence": {
          "const": true
        },
        "passForbidsDemonstratedNonconformance": {
          "const": true
        },
        "failRequiresDemonstratedNonconformance": {
          "const": true
        },
        "blockedRequiresUnavailablePrerequisite": {
          "const": true
        }
      }
    },
    "statusSemantics": {
      "type": "object",
      "required": [
        "passDefinition",
        "failDefinition",
        "blockedDefinition",
        "mixedConditionRule"
      ],
      "additionalProperties": false,
      "properties": {
        "passDefinition": {
          "type": "string",
          "const": "Every required review dimension for the producing role binding has been completed with the required evidence, and no unresolved blocking finding or required fix remains within the reviewed scope."
        },
        "failDefinition": {
          "type": "string",
          "const": "At least one reviewed dimension positively demonstrates a blocking defect, violated approved requirement or trust boundary, or other required fix that prevents the reviewed implementation from passing the code-review gate."
        },
        "blockedDefinition": {
          "type": "string",
          "const": "Required changed scope, code, configuration, test evidence, dependency information, threat context, or other review evidence is unavailable, missing, or unverifiable such that the required review cannot be completed."
        },
        "mixedConditionRule": {
          "type": "string",
          "const": "FAIL_ON_DEMONSTRATED_NONCONFORMANCE"
        }
      }
    },
    "allowedStatuses": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "const": "PASS"
        },
        {
          "type": "string",
          "const": "FAIL"
        },
        {
          "type": "string",
          "const": "BLOCKED"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true
    },
    "requiredHeadings": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "const": "# Code Review"
        },
        {
          "type": "string",
          "const": "## Status"
        },
        {
          "type": "string",
          "const": "## Provenance"
        },
        {
          "type": "string",
          "const": "## Revision"
        },
        {
          "type": "string",
          "const": "## Summary"
        },
        {
          "type": "string",
          "const": "## Evidence Reviewed"
        },
        {
          "type": "string",
          "const": "## Findings"
        },
        {
          "type": "string",
          "const": "## Required Fixes"
        },
        {
          "type": "string",
          "const": "## Handoff Target"
        }
      ],
      "items": false,
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true
    }
  }
}
