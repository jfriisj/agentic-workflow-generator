{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/agentic/artifacts/requirements.schema.json",
  "title": "Requirements Artifact Contract",
  "type": "object",
  "required": [
    "type",
    "version",
    "description",
    "pathPattern",
    "status",
    "provenance",
    "revision",
    "allowedStatuses",
    "requiredHeadings"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "Requirements"
    },
    "version": {
      "type": "string",
      "const": "0.4.0"
    },
    "description": {
      "type": "string",
      "const": "Artifact contract for requirements output produced by Requirements agents."
    },
    "pathPattern": {
      "type": "string",
      "const": "agent-output/requirements/*.md"
    },
    "status": {
      "type": "object",
      "required": [
        "heading",
        "pattern"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "const": "## Status"
        },
        "pattern": {
          "type": "string",
          "const": "PASS|FAIL|BLOCKED"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "heading",
        "requiredIdentities"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "const": "## Provenance"
        },
        "requiredIdentities": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "const": "artifactType"
            },
            {
              "type": "string",
              "const": "artifactVersion"
            },
            {
              "type": "string",
              "const": "workflow"
            },
            {
              "type": "string",
              "const": "workflowVersion"
            },
            {
              "type": "string",
              "const": "roleBinding"
            },
            {
              "type": "string",
              "const": "agentInstance"
            }
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true
        }
      }
    },
    "revision": {
      "type": "object",
      "required": [
        "heading",
        "pattern"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "const": "## Revision"
        },
        "pattern": {
          "type": "string",
          "const": "^[1-9][0-9]*$"
        }
      }
    },
    "allowedStatuses": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "const": "PASS"
        },
        {
          "type": "string",
          "const": "FAIL"
        },
        {
          "type": "string",
          "const": "BLOCKED"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true
    },
    "requiredHeadings": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "const": "# Requirements"
        },
        {
          "type": "string",
          "const": "## Status"
        },
        {
          "type": "string",
          "const": "## Provenance"
        },
        {
          "type": "string",
          "const": "## Revision"
        },
        {
          "type": "string",
          "const": "## Summary"
        },
        {
          "type": "string",
          "const": "## Scope"
        },
        {
          "type": "string",
          "const": "## Requirements"
        },
        {
          "type": "string",
          "const": "## Acceptance Criteria"
        },
        {
          "type": "string",
          "const": "## Assumptions"
        },
        {
          "type": "string",
          "const": "## Constraints"
        },
        {
          "type": "string",
          "const": "## Handoff Target"
        }
      ],
      "items": false,
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true
    }
  }
}
