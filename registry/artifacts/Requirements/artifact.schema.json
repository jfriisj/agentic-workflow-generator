{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/agentic/artifacts/requirements.schema.json",
  "title": "Requirements Artifact Contract",
  "type": "object",
  "required": [
    "type",
    "version",
    "description",
    "pathPattern",
    "status",
    "provenance",
    "revision",
    "evidence",
    "statusInvariants",
    "statusSemantics",
    "allowedStatuses",
    "requiredHeadings"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "Requirements"
    },
    "version": {
      "type": "string",
      "const": "0.7.0"
    },
    "description": {
      "type": "string",
      "const": "Artifact contract for requirements output produced by Requirements agents."
    },
    "pathPattern": {
      "type": "string",
      "const": "agent-output/requirements/*.md"
    },
    "status": {
      "type": "object",
      "required": [
        "heading",
        "pattern"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "const": "## Status"
        },
        "pattern": {
          "type": "string",
          "const": "PASS|FAIL|BLOCKED"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "heading",
        "requiredIdentities"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "const": "## Provenance"
        },
        "requiredIdentities": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "const": "artifactType"
            },
            {
              "type": "string",
              "const": "artifactVersion"
            },
            {
              "type": "string",
              "const": "workflow"
            },
            {
              "type": "string",
              "const": "workflowVersion"
            },
            {
              "type": "string",
              "const": "roleBinding"
            },
            {
              "type": "string",
              "const": "agentInstance"
            }
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true
        }
      }
    },
    "revision": {
      "type": "object",
      "required": [
        "heading",
        "pattern"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "const": "## Revision"
        },
        "pattern": {
          "type": "string",
          "const": "^[1-9][0-9]*$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "heading",
        "requiredFields"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "const": "## Evidence"
        },
        "requiredFields": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "const": "claim"
            },
            {
              "type": "string",
              "const": "source"
            },
            {
              "type": "string",
              "const": "reproduction"
            },
            {
              "type": "string",
              "const": "result"
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true
        }
      }
    },
    "statusInvariants": {
      "type": "object",
      "required": [
        "passRequiresCompleteEvidence",
        "passForbidsDemonstratedNonconformance",
        "failRequiresDemonstratedNonconformance",
        "blockedRequiresUnavailablePrerequisite"
      ],
      "additionalProperties": false,
      "properties": {
        "passRequiresCompleteEvidence": {
          "const": true
        },
        "passForbidsDemonstratedNonconformance": {
          "const": true
        },
        "failRequiresDemonstratedNonconformance": {
          "const": true
        },
        "blockedRequiresUnavailablePrerequisite": {
          "const": true
        }
      }
    },
    "statusSemantics": {
      "type": "object",
      "required": [
        "passDefinition",
        "failDefinition",
        "blockedDefinition",
        "mixedConditionRule"
      ],
      "additionalProperties": false,
      "properties": {
        "passDefinition": {
          "type": "string",
          "const": "Scope is explicit; requirements are internally consistent; acceptance criteria are testable; material assumptions and constraints are recorded; and no unresolved issue prevents downstream design."
        },
        "failDefinition": {
          "type": "string",
          "const": "Supplied requirements or constraints are demonstrably contradictory or impossible to satisfy as stated."
        },
        "blockedDefinition": {
          "type": "string",
          "const": "A stakeholder decision, required source information, scope boundary, or acceptance threshold necessary to complete the requirements contract is unavailable, missing, or unverifiable."
        },
        "mixedConditionRule": {
          "type": "string",
          "const": "FAIL_ON_DEMONSTRATED_NONCONFORMANCE"
        }
      }
    },
    "allowedStatuses": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "const": "PASS"
        },
        {
          "type": "string",
          "const": "FAIL"
        },
        {
          "type": "string",
          "const": "BLOCKED"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true
    },
    "requiredHeadings": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "const": "# Requirements"
        },
        {
          "type": "string",
          "const": "## Status"
        },
        {
          "type": "string",
          "const": "## Provenance"
        },
        {
          "type": "string",
          "const": "## Revision"
        },
        {
          "type": "string",
          "const": "## Evidence"
        },
        {
          "type": "string",
          "const": "## Summary"
        },
        {
          "type": "string",
          "const": "## Scope"
        },
        {
          "type": "string",
          "const": "## Requirements"
        },
        {
          "type": "string",
          "const": "## Acceptance Criteria"
        },
        {
          "type": "string",
          "const": "## Assumptions"
        },
        {
          "type": "string",
          "const": "## Constraints"
        },
        {
          "type": "string",
          "const": "## Handoff Target"
        }
      ],
      "items": false,
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true
    }
  }
}
