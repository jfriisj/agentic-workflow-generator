{
  "type": "Requirements",
  "version": "0.4.0",
  "description": "Artifact contract for requirements output produced by Requirements agents.",
  "pathPattern": "agent-output/requirements/*.md",
  "status": {
    "heading": "## Status",
    "pattern": "PASS|FAIL|BLOCKED"
  },
  "provenance": {
    "heading": "## Provenance",
    "requiredIdentities": [
      "artifactType",
      "artifactVersion",
      "workflow",
      "workflowVersion",
      "roleBinding",
      "agentInstance"
    ]
  },
  "revision": {
    "heading": "## Revision",
    "pattern": "^[1-9][0-9]*$"
  },
  "allowedStatuses": [
    "PASS",
    "FAIL",
    "BLOCKED"
  ],
  "requiredHeadings": [
    "# Requirements",
    "## Status",
    "## Provenance",
    "## Revision",
    "## Summary",
    "## Scope",
    "## Requirements",
    "## Acceptance Criteria",
    "## Assumptions",
    "## Constraints",
    "## Handoff Target"
  ]
}
