{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/agentic/artifacts/q-a-report.schema.json",
  "title": "QAReport Artifact Contract",
  "type": "object",
  "required": [
    "type",
    "version",
    "description",
    "pathPattern",
    "status",
    "provenance",
    "revision",
    "evidence",
    "statusInvariants",
    "statusSemantics",
    "allowedStatuses",
    "requiredHeadings"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "QAReport"
    },
    "version": {
      "type": "string",
      "const": "0.7.0"
    },
    "description": {
      "type": "string",
      "const": "Artifact contract for final QA gate output."
    },
    "pathPattern": {
      "type": "string",
      "const": "agent-output/qa-report/*.md"
    },
    "status": {
      "type": "object",
      "required": [
        "heading",
        "pattern"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "const": "## Status"
        },
        "pattern": {
          "type": "string",
          "const": "PASS|FAIL|BLOCKED"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "heading",
        "requiredIdentities"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "const": "## Provenance"
        },
        "requiredIdentities": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "const": "artifactType"
            },
            {
              "type": "string",
              "const": "artifactVersion"
            },
            {
              "type": "string",
              "const": "workflow"
            },
            {
              "type": "string",
              "const": "workflowVersion"
            },
            {
              "type": "string",
              "const": "roleBinding"
            },
            {
              "type": "string",
              "const": "agentInstance"
            }
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true
        }
      }
    },
    "revision": {
      "type": "object",
      "required": [
        "heading",
        "pattern"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "const": "## Revision"
        },
        "pattern": {
          "type": "string",
          "const": "^[1-9][0-9]*$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "heading",
        "requiredFields"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "const": "## Evidence"
        },
        "requiredFields": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "const": "claim"
            },
            {
              "type": "string",
              "const": "source"
            },
            {
              "type": "string",
              "const": "reproduction"
            },
            {
              "type": "string",
              "const": "result"
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true
        }
      }
    },
    "statusInvariants": {
      "type": "object",
      "required": [
        "passRequiresCompleteEvidence",
        "passForbidsDemonstratedNonconformance",
        "failRequiresDemonstratedNonconformance",
        "blockedRequiresUnavailablePrerequisite"
      ],
      "additionalProperties": false,
      "properties": {
        "passRequiresCompleteEvidence": {
          "const": true
        },
        "passForbidsDemonstratedNonconformance": {
          "const": true
        },
        "failRequiresDemonstratedNonconformance": {
          "const": true
        },
        "blockedRequiresUnavailablePrerequisite": {
          "const": true
        }
      }
    },
    "statusSemantics": {
      "type": "object",
      "required": [
        "passDefinition",
        "failDefinition",
        "blockedDefinition",
        "mixedConditionRule"
      ],
      "additionalProperties": false,
      "properties": {
        "passDefinition": {
          "type": "string",
          "const": "Every required acceptance criterion is satisfied by valid evidence and all required upstream gates pass."
        },
        "failDefinition": {
          "type": "string",
          "const": "Valid evidence demonstrates that at least one required acceptance criterion is not satisfied, or a required upstream gate has an applicable `FAIL` result that QA is not permitted to override."
        },
        "blockedDefinition": {
          "type": "string",
          "const": "Required evidence, artifacts, revisions, environments, decisions, or upstream gate evidence is unavailable, missing, stale, or unverifiable such that QA cannot establish the complete acceptance claim."
        },
        "mixedConditionRule": {
          "type": "string",
          "const": "FAIL_ON_DEMONSTRATED_NONCONFORMANCE"
        }
      }
    },
    "allowedStatuses": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "const": "PASS"
        },
        {
          "type": "string",
          "const": "FAIL"
        },
        {
          "type": "string",
          "const": "BLOCKED"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true
    },
    "requiredHeadings": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "const": "# QA Report"
        },
        {
          "type": "string",
          "const": "## Status"
        },
        {
          "type": "string",
          "const": "## Provenance"
        },
        {
          "type": "string",
          "const": "## Revision"
        },
        {
          "type": "string",
          "const": "## Evidence"
        },
        {
          "type": "string",
          "const": "## Summary"
        },
        {
          "type": "string",
          "const": "## Evidence Reviewed"
        },
        {
          "type": "string",
          "const": "## Gate Results"
        },
        {
          "type": "string",
          "const": "## Release Risks"
        },
        {
          "type": "string",
          "const": "## Required Follow-up"
        },
        {
          "type": "string",
          "const": "## Handoff Target"
        }
      ],
      "items": false,
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true
    }
  }
}
