{
  "name": "opencode",
  "version": "0.1.0",
  "description": "Target adapter for generating OpenCode agents, skills, and project instructions.",
  "outputPaths": {
    "agents": ".opencode/agents",
    "skills": ".opencode/skills",
    "instructions": "AGENTS.md",
    "config": "opencode.json"
  },
  "permissionMapping": {
    "read-only": {
      "edit": "deny",
      "bash": "deny"
    },
    "implementation": {
      "edit": "allow",
      "bash": "allow"
    },
    "test-runner": {
      "edit": "allow",
      "bash": "ask"
    }
  },
  "ownedPaths": [
    ".opencode/agents",
    ".opencode/skills",
    "AGENTS.md",
    "opencode.json"
  ]
}
