{
  "name": "lean-delivery",
  "version": "0.1.0",
  "description": "A compact fail-closed delivery workflow for focused changes that require explicit requirements, implementation, testing, and code review without a separate architecture or QA phase.",
  "startState": "Requirements",
  "terminalStates": [
    "Done",
    "Blocked"
  ],
  "states": [
    {
      "name": "Requirements",
      "agent": "Requirements",
      "gate": "requirements-review"
    },
    {
      "name": "Implementer",
      "agent": "Implementer",
      "gate": "implementation-complete"
    },
    {
      "name": "TestRunner",
      "agent": "TestRunner",
      "gate": "test-review"
    },
    {
      "name": "CodeReviewer",
      "agent": "CodeReviewer",
      "gate": "code-review"
    },
    {
      "name": "Done",
      "terminal": true
    },
    {
      "name": "Blocked",
      "terminal": true
    }
  ],
  "defaultFailureRoute": "Orchestrator",
  "failClosed": true,
  "transitions": [
    {
      "from": "Requirements",
      "to": "Implementer",
      "on": "pass"
    },
    {
      "from": "Requirements",
      "to": "Blocked",
      "on": "fail"
    },
    {
      "from": "Implementer",
      "to": "TestRunner",
      "on": "pass"
    },
    {
      "from": "Implementer",
      "to": "Blocked",
      "on": "fail"
    },
    {
      "from": "TestRunner",
      "to": "CodeReviewer",
      "on": "pass"
    },
    {
      "from": "TestRunner",
      "to": "Implementer",
      "on": "fail"
    },
    {
      "from": "CodeReviewer",
      "to": "Done",
      "on": "pass"
    },
    {
      "from": "CodeReviewer",
      "to": "Implementer",
      "on": "fail"
    }
  ]
}
