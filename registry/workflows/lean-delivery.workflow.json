{
  "name": "lean-delivery",
  "version": "0.2.0",
  "description": "A compact fail-closed delivery workflow for focused changes that require explicit requirements, implementation, testing, and code review without a separate architecture or QA phase.",
  "startState": "Requirements",
  "terminalStates": [
    "Done",
    "Blocked"
  ],
  "defaultFailureState": "Blocked",
  "failClosed": true,
  "states": [
    {
      "name": "Requirements",
      "gate": {
        "name": "requirements-review",
        "blocking": true,
        "requiredCapabilities": [
          "requirements.elicit",
          "requirements.define-acceptance-criteria"
        ],
        "requiredArtifacts": [
          "Requirements"
        ]
      }
    },
    {
      "name": "Implementer",
      "gate": {
        "name": "implementation-complete",
        "blocking": true,
        "requiredCapabilities": [
          "implementation.code",
          "implementation.refactor",
          "implementation.update-tests"
        ],
        "requiredArtifacts": [
          "ImplementationReport"
        ]
      }
    },
    {
      "name": "TestRunner",
      "gate": {
        "name": "test-review",
        "blocking": true,
        "requiredCapabilities": [
          "test.run",
          "test.report",
          "test.diagnose-failure"
        ],
        "requiredArtifacts": [
          "TestReport"
        ]
      }
    },
    {
      "name": "CodeReviewer",
      "gate": {
        "name": "code-review",
        "blocking": true,
        "requiredCapabilities": [
          "review.clean-code",
          "review.tests",
          "review.security"
        ],
        "requiredArtifacts": [
          "CodeReview"
        ]
      }
    },
    {
      "name": "Done",
      "terminal": true
    },
    {
      "name": "Blocked",
      "terminal": true
    }
  ],
  "transitions": [
    {
      "from": "Requirements",
      "to": "Implementer",
      "on": "pass"
    },
    {
      "from": "Requirements",
      "to": "Blocked",
      "on": "fail"
    },
    {
      "from": "Implementer",
      "to": "TestRunner",
      "on": "pass"
    },
    {
      "from": "Implementer",
      "to": "Blocked",
      "on": "fail"
    },
    {
      "from": "TestRunner",
      "to": "CodeReviewer",
      "on": "pass"
    },
    {
      "from": "TestRunner",
      "to": "Implementer",
      "on": "fail"
    },
    {
      "from": "CodeReviewer",
      "to": "Done",
      "on": "pass"
    },
    {
      "from": "CodeReviewer",
      "to": "Implementer",
      "on": "fail"
    }
  ]
}
