{
  "name": "review-heavy-delivery",
  "version": "0.2.0",
  "description": "A fail-closed delivery workflow that performs independent code review before test execution and finishes with QA acceptance.",
  "startState": "Requirements",
  "terminalStates": [
    "Done",
    "Blocked"
  ],
  "defaultFailureState": "Blocked",
  "failClosed": true,
  "states": [
    {
      "name": "Requirements",
      "gate": {
        "name": "requirements-review",
        "blocking": true,
        "requiredCapabilities": [
          "requirements.elicit",
          "requirements.define-acceptance-criteria"
        ],
        "requiredArtifacts": [
          "Requirements"
        ]
      }
    },
    {
      "name": "Architect",
      "gate": {
        "name": "architecture-review",
        "blocking": true,
        "requiredCapabilities": [
          "architecture.design",
          "architecture.evaluate-tradeoffs"
        ],
        "requiredArtifacts": [
          "ArchitectureDecision"
        ]
      }
    },
    {
      "name": "Implementer",
      "gate": {
        "name": "implementation-complete",
        "blocking": true,
        "requiredCapabilities": [
          "implementation.code",
          "implementation.refactor",
          "implementation.update-tests"
        ],
        "requiredArtifacts": [
          "ImplementationReport"
        ]
      }
    },
    {
      "name": "CodeReviewer",
      "gate": {
        "name": "pre-test-code-review",
        "blocking": true,
        "requiredCapabilities": [
          "review.clean-code",
          "review.tests",
          "review.security"
        ],
        "requiredArtifacts": [
          "CodeReview"
        ]
      }
    },
    {
      "name": "TestRunner",
      "gate": {
        "name": "test-review",
        "blocking": true,
        "requiredCapabilities": [
          "test.run",
          "test.report",
          "test.diagnose-failure"
        ],
        "requiredArtifacts": [
          "TestReport"
        ]
      }
    },
    {
      "name": "QA",
      "gate": {
        "name": "qa-review",
        "blocking": true,
        "requiredCapabilities": [
          "qa.verify-acceptance-criteria",
          "qa.validate-evidence"
        ],
        "requiredArtifacts": [
          "QAReport"
        ]
      }
    },
    {
      "name": "Done",
      "terminal": true
    },
    {
      "name": "Blocked",
      "terminal": true
    }
  ],
  "transitions": [
    {
      "from": "Requirements",
      "to": "Architect",
      "on": "pass"
    },
    {
      "from": "Requirements",
      "to": "Blocked",
      "on": "fail"
    },
    {
      "from": "Architect",
      "to": "Implementer",
      "on": "pass"
    },
    {
      "from": "Architect",
      "to": "Blocked",
      "on": "fail"
    },
    {
      "from": "Implementer",
      "to": "CodeReviewer",
      "on": "pass"
    },
    {
      "from": "Implementer",
      "to": "Blocked",
      "on": "fail"
    },
    {
      "from": "CodeReviewer",
      "to": "TestRunner",
      "on": "pass"
    },
    {
      "from": "CodeReviewer",
      "to": "Implementer",
      "on": "fail"
    },
    {
      "from": "TestRunner",
      "to": "QA",
      "on": "pass"
    },
    {
      "from": "TestRunner",
      "to": "Implementer",
      "on": "fail"
    },
    {
      "from": "QA",
      "to": "Done",
      "on": "pass"
    },
    {
      "from": "QA",
      "to": "Implementer",
      "on": "fail"
    }
  ]
}
