{
  "$schema": "./schemas/agentic.schema.json",
  "schemaVersion": "0.7.0",
  "project": {
    "name": "agentic-workflow-generator",
    "type": "agentic-generator",
    "description": "A platform-neutral generator/compiler for agentic software delivery workflows.",
    "languageProfiles": [
      "typescript"
    ],
    "runtimeProfiles": [
      "node"
    ],
    "architectureProfile": "platform-neutral-workflow-compiler"
  },
  "generator": {
    "name": "agentic-workflow-generator",
    "version": "0.1.0",
    "mode": "compiler",
    "runtimeExecution": false
  },
  "selection": {
    "bundle": {
      "name": "orchestrated-delivery",
      "version": "0.2.0"
    },
    "profile": {
      "name": "microservice-platform",
      "version": "0.2.0"
    },
    "workflow": {
      "name": "orchestrated-delivery",
      "version": "0.2.0"
    }
  },
  "targets": [
    {
      "name": "opencode",
      "enabled": true,
      "priority": 1
    },
    {
      "name": "vscode-copilot",
      "enabled": true,
      "priority": 2
    }
  ],
  "workflow": {
    "name": "orchestrated-delivery",
    "version": "0.2.0",
    "description": "A fail-closed software delivery workflow where routing is owned by the orchestrator and quality gates control progress.",
    "startState": "Requirements",
    "terminalStates": [
      "Done",
      "Blocked"
    ],
    "defaultFailureState": "Blocked",
    "failClosed": true,
    "states": [
      {
        "name": "Requirements",
        "terminal": false,
        "gate": "requirements-review"
      },
      {
        "name": "Architect",
        "terminal": false,
        "gate": "architecture-review"
      },
      {
        "name": "Implementer",
        "terminal": false,
        "gate": "implementation-complete"
      },
      {
        "name": "TestRunner",
        "terminal": false,
        "gate": "test-review"
      },
      {
        "name": "CodeReviewer",
        "terminal": false,
        "gate": "code-review"
      },
      {
        "name": "QA",
        "terminal": false,
        "gate": "qa-review"
      },
      {
        "name": "Done",
        "terminal": true,
        "gate": null
      },
      {
        "name": "Blocked",
        "terminal": true,
        "gate": null
      }
    ],
    "transitions": [
      {
        "from": "Requirements",
        "to": "Architect",
        "on": "pass"
      },
      {
        "from": "Requirements",
        "to": "Blocked",
        "on": "fail"
      },
      {
        "from": "Architect",
        "to": "Implementer",
        "on": "pass"
      },
      {
        "from": "Architect",
        "to": "Blocked",
        "on": "fail"
      },
      {
        "from": "Implementer",
        "to": "TestRunner",
        "on": "pass"
      },
      {
        "from": "Implementer",
        "to": "Blocked",
        "on": "fail"
      },
      {
        "from": "TestRunner",
        "to": "CodeReviewer",
        "on": "pass"
      },
      {
        "from": "TestRunner",
        "to": "Implementer",
        "on": "fail"
      },
      {
        "from": "CodeReviewer",
        "to": "QA",
        "on": "pass"
      },
      {
        "from": "CodeReviewer",
        "to": "Implementer",
        "on": "fail"
      },
      {
        "from": "QA",
        "to": "Done",
        "on": "pass"
      },
      {
        "from": "QA",
        "to": "Blocked",
        "on": "fail"
      }
    ]
  },
  "permissionProfiles": [
    {
      "name": "read-only",
      "version": "0.1.0",
      "description": "Read-only access for analysis, review, evaluation, requirements, architecture, quality assurance, and routing.",
      "read": true,
      "write": false,
      "edit": false,
      "bash": "deny"
    },
    {
      "name": "implementation",
      "version": "0.1.0",
      "description": "Full repository modification access for approved implementation work.",
      "read": true,
      "write": true,
      "edit": true,
      "bash": "allow"
    },
    {
      "name": "test-runner",
      "version": "0.1.0",
      "description": "Repository access for running tests, collecting evidence, and writing test outputs with restricted shell execution.",
      "read": true,
      "write": true,
      "edit": true,
      "bash": "limited"
    }
  ],
  "skills": [
    {
      "name": "architecture-design",
      "version": "0.1.0",
      "description": "Use when designing system boundaries, evaluating architectural alternatives, and documenting evidence-based tradeoffs.",
      "provides": [
        "architecture.design",
        "architecture.evaluate-tradeoffs"
      ],
      "contentPath": "SKILL.md",
      "contextBudget": {
        "maxTokens": 2600
      },
      "requiresCapabilities": []
    },
    {
      "name": "code-review-clean-code",
      "version": "0.1.0",
      "description": "Use when reviewing code for readability, naming, structure, duplication, simplicity, and maintainability.",
      "provides": [
        "review.clean-code"
      ],
      "contentPath": "SKILL.md",
      "contextBudget": {
        "maxTokens": 1800
      },
      "requiresCapabilities": []
    },
    {
      "name": "code-review-tests",
      "version": "0.1.0",
      "description": "Use when reviewing test coverage, validation evidence, failure reporting, regression risk, and test reliability.",
      "provides": [
        "review.tests"
      ],
      "contentPath": "SKILL.md",
      "contextBudget": {
        "maxTokens": 1600
      },
      "requiresCapabilities": []
    },
    {
      "name": "implementation-engineering",
      "version": "0.1.0",
      "description": "Use when implementing or refactoring approved behavior and updating tests while preserving requirement and architecture alignment.",
      "provides": [
        "implementation.code",
        "implementation.refactor",
        "implementation.update-tests"
      ],
      "contentPath": "SKILL.md",
      "contextBudget": {
        "maxTokens": 2800
      },
      "requiresCapabilities": []
    },
    {
      "name": "qa-acceptance-validation",
      "version": "0.1.0",
      "description": "Use when verifying acceptance criteria against independent test, review, and artifact evidence.",
      "provides": [
        "qa.verify-acceptance-criteria",
        "qa.validate-evidence"
      ],
      "contentPath": "SKILL.md",
      "contextBudget": {
        "maxTokens": 2400
      },
      "requiresCapabilities": []
    },
    {
      "name": "requirements-analysis",
      "version": "0.1.0",
      "description": "Use when eliciting requirements, resolving scope and constraints, and defining measurable acceptance criteria.",
      "provides": [
        "requirements.elicit",
        "requirements.define-acceptance-criteria"
      ],
      "contentPath": "SKILL.md",
      "contextBudget": {
        "maxTokens": 2400
      },
      "requiresCapabilities": []
    },
    {
      "name": "security-review",
      "version": "0.1.0",
      "description": "Use when reviewing changed code and configuration for concrete security risks, unsafe trust boundaries, and missing mitigations.",
      "provides": [
        "review.security"
      ],
      "contentPath": "SKILL.md",
      "contextBudget": {
        "maxTokens": 2400
      },
      "requiresCapabilities": []
    },
    {
      "name": "test-execution",
      "version": "0.1.0",
      "description": "Use when executing authoritative tests, preserving raw results, diagnosing failures, and producing reproducible test evidence.",
      "provides": [
        "test.run",
        "test.report",
        "test.diagnose-failure"
      ],
      "contentPath": "SKILL.md",
      "contextBudget": {
        "maxTokens": 2600
      },
      "requiresCapabilities": []
    },
    {
      "name": "workflow-routing",
      "version": "0.1.0",
      "description": "Use when the Orchestrator must route work through workflow states, gates, failures, and handoffs without bypassing evidence requirements.",
      "provides": [
        "workflow.route",
        "workflow.validate-state",
        "workflow.handoff"
      ],
      "contentPath": "SKILL.md",
      "contextBudget": {
        "maxTokens": 1800
      },
      "requiresCapabilities": []
    }
  ],
  "artifacts": [
    {
      "type": "ArchitectureDecision",
      "version": "0.6.0",
      "description": "Artifact contract for architecture decision output produced by Architect agents.",
      "pathPattern": "agent-output/architecture-decision/*.md",
      "status": {
        "heading": "## Status",
        "pattern": "PASS|FAIL|BLOCKED"
      },
      "provenance": {
        "heading": "## Provenance",
        "requiredIdentities": [
          "artifactType",
          "artifactVersion",
          "workflow",
          "workflowVersion",
          "roleBinding",
          "agentInstance"
        ]
      },
      "revision": {
        "heading": "## Revision",
        "pattern": "^[1-9][0-9]*$"
      },
      "statusInvariants": {
        "passRequiresCompleteEvidence": true,
        "passForbidsDemonstratedNonconformance": true,
        "failRequiresDemonstratedNonconformance": true,
        "blockedRequiresUnavailablePrerequisite": true
      },
      "statusSemantics": {
        "passDefinition": "The decision traces to approved requirements; system boundaries are explicit; material alternatives and tradeoffs are evaluated; consequences and risks are documented; and no unresolved requirement prevents implementation.",
        "failDefinition": "The proposed architecture demonstrably violates an approved requirement or constraint.",
        "blockedDefinition": "A requirement, quality attribute, constraint, or dependency fact necessary to make the architecture decision is unavailable, missing, or unverifiable.",
        "mixedConditionRule": "FAIL_ON_DEMONSTRATED_NONCONFORMANCE"
      },
      "allowedStatuses": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ],
      "requiredHeadings": [
        "# Architecture Decision",
        "## Status",
        "## Provenance",
        "## Revision",
        "## Summary",
        "## Context",
        "## Decision",
        "## Alternatives Considered",
        "## Consequences",
        "## Handoff Target"
      ]
    },
    {
      "type": "CodeReview",
      "version": "0.6.0",
      "description": "Artifact contract for code review gate output.",
      "pathPattern": "agent-output/code-review/*.md",
      "status": {
        "heading": "## Status",
        "pattern": "PASS|FAIL|BLOCKED"
      },
      "provenance": {
        "heading": "## Provenance",
        "requiredIdentities": [
          "artifactType",
          "artifactVersion",
          "workflow",
          "workflowVersion",
          "roleBinding",
          "agentInstance"
        ]
      },
      "revision": {
        "heading": "## Revision",
        "pattern": "^[1-9][0-9]*$"
      },
      "statusInvariants": {
        "passRequiresCompleteEvidence": true,
        "passForbidsDemonstratedNonconformance": true,
        "failRequiresDemonstratedNonconformance": true,
        "blockedRequiresUnavailablePrerequisite": true
      },
      "statusSemantics": {
        "passDefinition": "Every required review dimension for the producing role binding has been completed with the required evidence, and no unresolved blocking finding or required fix remains within the reviewed scope.",
        "failDefinition": "At least one reviewed dimension positively demonstrates a blocking defect, violated approved requirement or trust boundary, or other required fix that prevents the reviewed implementation from passing the code-review gate.",
        "blockedDefinition": "Required changed scope, code, configuration, test evidence, dependency information, threat context, or other review evidence is unavailable, missing, or unverifiable such that the required review cannot be completed.",
        "mixedConditionRule": "FAIL_ON_DEMONSTRATED_NONCONFORMANCE"
      },
      "allowedStatuses": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ],
      "requiredHeadings": [
        "# Code Review",
        "## Status",
        "## Provenance",
        "## Revision",
        "## Summary",
        "## Evidence Reviewed",
        "## Findings",
        "## Required Fixes",
        "## Handoff Target"
      ]
    },
    {
      "type": "ImplementationReport",
      "version": "0.6.0",
      "description": "Artifact contract for implementation output produced by Implementer agents.",
      "pathPattern": "agent-output/implementation/*.md",
      "status": {
        "heading": "## Status",
        "pattern": "PASS|FAIL|BLOCKED"
      },
      "provenance": {
        "heading": "## Provenance",
        "requiredIdentities": [
          "artifactType",
          "artifactVersion",
          "workflow",
          "workflowVersion",
          "roleBinding",
          "agentInstance"
        ]
      },
      "revision": {
        "heading": "## Revision",
        "pattern": "^[1-9][0-9]*$"
      },
      "statusInvariants": {
        "passRequiresCompleteEvidence": true,
        "passForbidsDemonstratedNonconformance": true,
        "failRequiresDemonstratedNonconformance": true,
        "blockedRequiresUnavailablePrerequisite": true
      },
      "statusSemantics": {
        "passDefinition": "The approved change is implemented; required tests owned by the implementation responsibility are updated; required implementation-level validation available at this boundary has been run; and known risks plus validation deliberately owned by later independent gates are disclosed.",
        "failDefinition": "The implementation or implementation-level validation positively demonstrates that the approved behavior is not satisfied.",
        "blockedDefinition": "An approved input, dependency, tool, credential, environment, or required decision necessary to complete the implementation responsibility is unavailable, missing, or unverifiable.",
        "mixedConditionRule": "FAIL_ON_DEMONSTRATED_NONCONFORMANCE"
      },
      "allowedStatuses": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ],
      "requiredHeadings": [
        "# Implementation Report",
        "## Status",
        "## Provenance",
        "## Revision",
        "## Summary",
        "## Files Changed",
        "## Implementation Notes",
        "## Validation Performed",
        "## Known Risks",
        "## Handoff Target"
      ]
    },
    {
      "type": "QAReport",
      "version": "0.6.0",
      "description": "Artifact contract for final QA gate output.",
      "pathPattern": "agent-output/qa-report/*.md",
      "status": {
        "heading": "## Status",
        "pattern": "PASS|FAIL|BLOCKED"
      },
      "provenance": {
        "heading": "## Provenance",
        "requiredIdentities": [
          "artifactType",
          "artifactVersion",
          "workflow",
          "workflowVersion",
          "roleBinding",
          "agentInstance"
        ]
      },
      "revision": {
        "heading": "## Revision",
        "pattern": "^[1-9][0-9]*$"
      },
      "statusInvariants": {
        "passRequiresCompleteEvidence": true,
        "passForbidsDemonstratedNonconformance": true,
        "failRequiresDemonstratedNonconformance": true,
        "blockedRequiresUnavailablePrerequisite": true
      },
      "statusSemantics": {
        "passDefinition": "Every required acceptance criterion is satisfied by valid evidence and all required upstream gates pass.",
        "failDefinition": "Valid evidence demonstrates that at least one required acceptance criterion is not satisfied, or a required upstream gate has an applicable `FAIL` result that QA is not permitted to override.",
        "blockedDefinition": "Required evidence, artifacts, revisions, environments, decisions, or upstream gate evidence is unavailable, missing, stale, or unverifiable such that QA cannot establish the complete acceptance claim.",
        "mixedConditionRule": "FAIL_ON_DEMONSTRATED_NONCONFORMANCE"
      },
      "allowedStatuses": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ],
      "requiredHeadings": [
        "# QA Report",
        "## Status",
        "## Provenance",
        "## Revision",
        "## Summary",
        "## Evidence Reviewed",
        "## Gate Results",
        "## Release Risks",
        "## Required Follow-up",
        "## Handoff Target"
      ]
    },
    {
      "type": "Requirements",
      "version": "0.6.0",
      "description": "Artifact contract for requirements output produced by Requirements agents.",
      "pathPattern": "agent-output/requirements/*.md",
      "status": {
        "heading": "## Status",
        "pattern": "PASS|FAIL|BLOCKED"
      },
      "provenance": {
        "heading": "## Provenance",
        "requiredIdentities": [
          "artifactType",
          "artifactVersion",
          "workflow",
          "workflowVersion",
          "roleBinding",
          "agentInstance"
        ]
      },
      "revision": {
        "heading": "## Revision",
        "pattern": "^[1-9][0-9]*$"
      },
      "statusInvariants": {
        "passRequiresCompleteEvidence": true,
        "passForbidsDemonstratedNonconformance": true,
        "failRequiresDemonstratedNonconformance": true,
        "blockedRequiresUnavailablePrerequisite": true
      },
      "statusSemantics": {
        "passDefinition": "Scope is explicit; requirements are internally consistent; acceptance criteria are testable; material assumptions and constraints are recorded; and no unresolved issue prevents downstream design.",
        "failDefinition": "Supplied requirements or constraints are demonstrably contradictory or impossible to satisfy as stated.",
        "blockedDefinition": "A stakeholder decision, required source information, scope boundary, or acceptance threshold necessary to complete the requirements contract is unavailable, missing, or unverifiable.",
        "mixedConditionRule": "FAIL_ON_DEMONSTRATED_NONCONFORMANCE"
      },
      "allowedStatuses": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ],
      "requiredHeadings": [
        "# Requirements",
        "## Status",
        "## Provenance",
        "## Revision",
        "## Summary",
        "## Scope",
        "## Requirements",
        "## Acceptance Criteria",
        "## Assumptions",
        "## Constraints",
        "## Handoff Target"
      ]
    },
    {
      "type": "TestReport",
      "version": "0.6.0",
      "description": "Artifact contract for test execution and validation output.",
      "pathPattern": "agent-output/test-report/*.md",
      "status": {
        "heading": "## Status",
        "pattern": "PASS|FAIL|BLOCKED"
      },
      "provenance": {
        "heading": "## Provenance",
        "requiredIdentities": [
          "artifactType",
          "artifactVersion",
          "workflow",
          "workflowVersion",
          "roleBinding",
          "agentInstance"
        ]
      },
      "revision": {
        "heading": "## Revision",
        "pattern": "^[1-9][0-9]*$"
      },
      "statusInvariants": {
        "passRequiresCompleteEvidence": true,
        "passForbidsDemonstratedNonconformance": true,
        "failRequiresDemonstratedNonconformance": true,
        "blockedRequiresUnavailablePrerequisite": true
      },
      "statusSemantics": {
        "passDefinition": "All required validation at the test-execution boundary has executed and passed, and no required test is missing or skipped.",
        "failDefinition": "At least one required test or validation command executes and positively demonstrates that the product does not satisfy the tested contract.",
        "blockedDefinition": "A required tool, dependency, environment, credential, fixture, or test input is unavailable, missing, or unverifiable such that required validation cannot execute or be established.",
        "mixedConditionRule": "FAIL_ON_DEMONSTRATED_NONCONFORMANCE"
      },
      "allowedStatuses": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ],
      "requiredHeadings": [
        "# Test Report",
        "## Status",
        "## Provenance",
        "## Revision",
        "## Summary",
        "## Test Commands",
        "## Test Results",
        "## Failures",
        "## Coverage Notes",
        "## Handoff Target"
      ]
    }
  ],
