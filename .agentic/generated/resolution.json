{
  "project": {
    "name": "agentic-workflow-generator",
    "type": "agentic-generator",
    "description": "A platform-neutral generator/compiler for agentic software delivery workflows.",
    "languageProfiles": [
      "typescript"
    ],
    "runtimeProfiles": [
      "node"
    ],
    "architectureProfile": "platform-neutral-workflow-compiler"
  },
  "workflow": {
    "name": "orchestrated-delivery",
    "version": "0.2.0",
    "description": "A fail-closed software delivery workflow where routing is owned by the orchestrator and quality gates control progress.",
    "startState": "Requirements",
    "terminalStates": [
      "Done",
      "Blocked"
    ],
    "defaultFailureState": "Blocked",
    "failClosed": true,
    "states": [
      {
        "name": "Requirements",
        "terminal": false,
        "gate": "requirements-review"
      },
      {
        "name": "Architect",
        "terminal": false,
        "gate": "architecture-review"
      },
      {
        "name": "Implementer",
        "terminal": false,
        "gate": "implementation-complete"
      },
      {
        "name": "TestRunner",
        "terminal": false,
        "gate": "test-review"
      },
      {
        "name": "CodeReviewer",
        "terminal": false,
        "gate": "code-review"
      },
      {
        "name": "QA",
        "terminal": false,
        "gate": "qa-review"
      },
      {
        "name": "Done",
        "terminal": true,
        "gate": null
      },
      {
        "name": "Blocked",
        "terminal": true,
        "gate": null
      }
    ],
    "transitions": [
      {
        "from": "Requirements",
        "to": "Architect",
        "on": "pass"
      },
      {
        "from": "Requirements",
        "to": "Blocked",
        "on": "fail"
      },
      {
        "from": "Architect",
        "to": "Implementer",
        "on": "pass"
      },
      {
        "from": "Architect",
        "to": "Blocked",
        "on": "fail"
      },
      {
        "from": "Implementer",
        "to": "TestRunner",
        "on": "pass"
      },
      {
        "from": "Implementer",
        "to": "Blocked",
        "on": "fail"
      },
      {
        "from": "TestRunner",
        "to": "CodeReviewer",
        "on": "pass"
      },
      {
        "from": "TestRunner",
        "to": "Implementer",
        "on": "fail"
      },
      {
        "from": "CodeReviewer",
        "to": "QA",
        "on": "pass"
      },
      {
        "from": "CodeReviewer",
        "to": "Implementer",
        "on": "fail"
      },
      {
        "from": "QA",
        "to": "Done",
        "on": "pass"
      },
      {
        "from": "QA",
        "to": "Blocked",
        "on": "fail"
      }
    ]
  },
  "agents": [],
  "targets": [
    {
      "name": "opencode",
      "enabled": true,
      "adapterPath": "registry/targets/opencode/adapter.json",
      "missing": false
    },
    {
      "name": "vscode-copilot",
      "enabled": true,
      "adapterPath": "registry/targets/vscode-copilot/adapter.json",
      "missing": false
    }
  ],
  "summary": {
    "agentCount": 0,
    "targetCount": 2,
    "availableSkillCount": 10,
    "producedArtifactBindingCount": 0,
    "errorCount": 1,
    "errors": [
      "workflow.profile must be a non-empty string"
    ]
  }
}
