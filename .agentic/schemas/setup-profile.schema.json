{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/setup-profile.schema.json",
  "title": "Agentic Guided Setup Profile",
  "type": "object",
  "required": [
    "schemaVersion",
    "mode",
    "setup",
    "answers",
    "selected",
    "policy"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string",
      "enum": [
        "0.2.0"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "greenfield",
        "brownfield"
      ]
    },
    "setup": {
      "type": "string",
      "minLength": 1
    },
    "answers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "question",
          "selected",
          "classification",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "selected": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "enum": [
              "recommended",
              "compatible"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "selected": {
      "type": "object",
      "required": [
        "bundle",
        "targets"
      ],
      "additionalProperties": false,
      "properties": {
        "bundle": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "failFast",
        "fallbackAllowed"
      ],
      "additionalProperties": false,
      "properties": {
        "failFast": {
          "type": "boolean",
          "const": true
        },
        "fallbackAllowed": {
          "type": "boolean",
          "const": false
        }
      }
    }
  }
}
