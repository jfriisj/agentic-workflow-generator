{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/agentic.schema.json",
  "title": "Agentic Compiled Composition Configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "generator",
    "selection",
    "targets",
    "workflow",
    "permissionProfiles",
    "skills",
    "artifacts",
    "agentInstances",
    "roleBindings",
    "stateOwnership",
    "controllerBinding",
    "workflowGates",
    "artifactProduction",
    "separationConstraints"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "0.8.0"
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "type",
        "description",
        "languageProfiles",
        "runtimeProfiles",
        "architectureProfile"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "languageProfiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "runtimeProfiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "architectureProfile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generator": {
      "type": "object",
      "required": [
        "name",
        "version",
        "mode",
        "runtimeExecution"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "agentic-workflow-generator"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "const": "compiler"
        },
        "runtimeExecution": {
          "const": false
        }
      }
    },
    "selection": {
      "type": "object",
      "required": [
        "bundle",
        "profile",
        "workflow"
      ],
      "additionalProperties": false,
      "properties": {
        "bundle": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "profile": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "workflow": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "name",
          "enabled",
          "priority"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "const": true
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "required": [
        "name",
        "version",
        "description",
        "startState",
        "terminalStates",
        "defaultFailureState",
        "failClosed",
        "states",
        "transitions"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "startState": {
          "type": "string",
          "minLength": 1
        },
        "terminalStates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "defaultFailureState": {
          "type": "string",
          "minLength": 1
        },
        "failClosed": {
          "const": true
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "terminal",
              "gate"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "terminal": {
                "type": "boolean"
              },
              "gate": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "on"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "on": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "permissionProfiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "description",
          "read",
          "write",
          "edit",
          "bash"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "read": {
            "type": "boolean"
          },
          "write": {
            "type": "boolean"
          },
          "edit": {
            "type": "boolean"
          },
          "bash": {
            "enum": [
              "deny",
              "limited",
              "allow"
            ]
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "description",
          "provides",
          "contentPath",
          "contextBudget",
          "requiresCapabilities"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "provides": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "contentPath": {
            "type": "string",
            "minLength": 1
          },
          "contextBudget": {
            "type": "object",
            "required": [
              "maxTokens"
            ],
            "additionalProperties": false,
            "properties": {
              "maxTokens": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "requiresCapabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "version",
          "description",
          "pathPattern",
          "status",
          "provenance",
          "revision",
          "evidence",
          "statusInvariants",
          "statusSemantics",
          "allowedStatuses",
          "requiredHeadings"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "pathPattern": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "object",
            "required": [
              "heading",
              "pattern"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 1
              },
              "pattern": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "provenance": {
            "type": "object",
            "required": [
              "heading",
              "requiredIdentities"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string",
                "const": "## Provenance"
              },
              "requiredIdentities": {
                "type": "array",
                "const": [
                  "artifactType",
                  "artifactVersion",
                  "workflow",
                  "workflowVersion",
                  "roleBinding",
                  "agentInstance"
                ]
              }
            }
          },
          "revision": {
            "type": "object",
            "required": [
              "heading",
              "pattern"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string",
                "const": "## Revision"
              },
              "pattern": {
                "type": "string",
                "const": "^[1-9][0-9]*$"
              }
            }
          },
          "evidence": {
            "type": "object",
            "required": [
              "heading",
              "requiredFields"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string",
                "const": "## Evidence"
              },
              "requiredFields": {
                "type": "array",
                "const": [
                  "claim",
                  "source",
                  "reproduction",
                  "result"
                ]
              }
            }
          },
          "statusInvariants": {
            "type": "object",
            "required": [
              "passRequiresCompleteEvidence",
              "passForbidsDemonstratedNonconformance",
              "failRequiresDemonstratedNonconformance",
              "blockedRequiresUnavailablePrerequisite"
            ],
            "additionalProperties": false,
            "properties": {
              "passRequiresCompleteEvidence": {
                "const": true
              },
              "passForbidsDemonstratedNonconformance": {
                "const": true
              },
              "failRequiresDemonstratedNonconformance": {
                "const": true
              },
              "blockedRequiresUnavailablePrerequisite": {
                "const": true
              }
            }
          },
          "statusSemantics": {
            "type": "object",
            "required": [
              "passDefinition",
              "failDefinition",
              "blockedDefinition",
              "mixedConditionRule"
            ],
            "additionalProperties": false,
            "properties": {
              "passDefinition": {
                "type": "string",
                "minLength": 1
              },
              "failDefinition": {
                "type": "string",
                "minLength": 1
              },
              "blockedDefinition": {
                "type": "string",
                "minLength": 1
              },
              "mixedConditionRule": {
                "type": "string",
                "const": "FAIL_ON_DEMONSTRATED_NONCONFORMANCE"
              }
            }
          },
          "allowedStatuses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "requiredHeadings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        }
      }
    },
    "agentInstances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "profile",
          "displayName",
          "permissionProfile",
          "sharedContextPolicy",
          "roleBindings",
          "requiredCapabilities",
          "selectedSkills",
          "produces",
          "responsibilities",
          "guardrails"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "type": "object",
            "required": [
              "name",
              "version",
              "role",
              "description"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "permissionProfile": {
            "type": "string",
            "minLength": 1
          },
          "sharedContextPolicy": {
            "const": "shared-with-assigned-bindings"
          },
          "roleBindings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "requiredCapabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "selectedSkills": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "produces": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "responsibilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "guardrails": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        }
      }
    },
    "roleBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "roleName",
          "bindingType",
          "agentInstance",
          "requiredCapabilities",
          "selectedSkills",
          "providedCapabilities",
          "produces",
          "responsibilities",
          "guardrails"
        ],
        "additionalProperties": false,
        "properties": {
          "roleName": {
            "type": "string",
            "minLength": 1
          },
          "bindingType": {
            "enum": [
              "state-owner",
              "workflow-controller"
            ]
          },
          "agentInstance": {
            "type": "string",
            "minLength": 1
          },
          "workflowState": {
            "type": "string",
            "minLength": 1
          },
          "workflowGate": {
            "type": "string",
            "minLength": 1
          },
          "requiredCapabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "selectedSkills": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "providedCapabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "produces": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "responsibilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "guardrails": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "bindingType": {
                  "const": "state-owner"
                }
              }
            },
            "then": {
              "required": [
                "workflowState",
                "workflowGate"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "workflowState"
                    ]
                  },
                  {
                    "required": [
                      "workflowGate"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "stateOwnership": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "workflowState",
          "roleBinding",
          "agentInstance"
        ],
        "additionalProperties": false,
        "properties": {
          "workflowState": {
            "type": "string",
            "minLength": 1
          },
          "roleBinding": {
            "type": "string",
            "minLength": 1
          },
          "agentInstance": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "controllerBinding": {
      "type": "string",
      "minLength": 1
    },
    "workflowGates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "workflowState",
          "name",
          "blocking",
          "ownerRoleBinding",
          "ownerAgentInstance",
          "requiredCapabilities",
          "requiredArtifacts"
        ],
        "additionalProperties": false,
        "properties": {
          "workflowState": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          },
          "ownerRoleBinding": {
            "type": "string",
            "minLength": 1
          },
          "ownerAgentInstance": {
            "type": "string",
            "minLength": 1
          },
          "requiredCapabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "requiredArtifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        }
      }
    },
    "artifactProduction": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifactType",
          "roleBinding",
          "agentInstance"
        ],
        "additionalProperties": false,
        "properties": {
          "artifactType": {
            "type": "string",
            "minLength": 1
          },
          "roleBinding": {
            "type": "string",
            "minLength": 1
          },
          "agentInstance": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "separationConstraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "mode",
          "roleBindings",
          "agentInstances",
          "requireDistinctInstances",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "const": "required"
          },
          "roleBindings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 2
          },
          "agentInstances": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 2
          },
          "requireDistinctInstances": {
            "const": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
