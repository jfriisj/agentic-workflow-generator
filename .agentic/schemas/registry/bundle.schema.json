{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "name",
    "description",
    "version",
    "profile",
    "workflow",
    "agentInstances",
    "roleBindings",
    "separationPolicies",
    "skills",
    "artifacts",
    "targets"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "agentInstances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "profile",
          "displayName",
          "permissionProfile",
          "sharedContextPolicy"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "permissionProfile": {
            "type": "string",
            "minLength": 1
          },
          "sharedContextPolicy": {
            "const": "shared-with-assigned-bindings"
          }
        }
      }
    },
    "roleBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "roleName",
          "bindingType",
          "agentInstance",
          "requiredCapabilities",
          "selectedSkills",
          "produces",
          "inputArtifacts",
          "responsibilities",
          "guardrails"
        ],
        "additionalProperties": false,
        "properties": {
          "roleName": {
            "type": "string",
            "minLength": 1
          },
          "bindingType": {
            "enum": [
              "state-owner",
              "workflow-controller"
            ]
          },
          "agentInstance": {
            "type": "string",
            "minLength": 1
          },
          "workflowState": {
            "type": "string",
            "minLength": 1
          },
          "requiredCapabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "selectedSkills": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "produces": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "inputArtifacts": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": [
                "artifactType",
                "roleBinding"
              ],
              "additionalProperties": false,
              "properties": {
                "artifactType": {
                  "type": "string",
                  "minLength": 1
                },
                "roleBinding": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "responsibilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "guardrails": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "workflowGate": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "bindingType": {
                  "const": "state-owner"
                }
              },
              "required": [
                "bindingType"
              ]
            },
            "then": {
              "required": [
                "workflowState",
                "workflowGate"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "bindingType": {
                  "const": "workflow-controller"
                }
              },
              "required": [
                "bindingType"
              ]
            },
            "then": {
              "allOf": [
                {
                  "not": {
                    "required": [
                      "workflowState"
                    ]
                  }
                },
                {
                  "not": {
                    "required": [
                      "workflowGate"
                    ]
                  }
                },
                {
                  "properties": {
                    "inputArtifacts": {
                      "maxItems": 0
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "separationPolicies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "mode",
          "roleBindings",
          "requireDistinctInstances",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "const": "required"
          },
          "roleBindings": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2
          },
          "requireDistinctInstances": {
            "const": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  }
}
