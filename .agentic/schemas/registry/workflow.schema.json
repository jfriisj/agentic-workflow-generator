{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "name",
    "version",
    "description",
    "startState",
    "terminalStates",
    "defaultFailureState",
    "failClosed",
    "states",
    "transitions"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "startState": {
      "type": "string",
      "minLength": 1
    },
    "terminalStates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "defaultFailureState": {
      "type": "string",
      "minLength": 1
    },
    "failClosed": {
      "type": "boolean"
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "name",
              "gate"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "gate": {
                "type": "object",
                "required": [
                  "name",
                  "blocking",
                  "requiredCapabilities",
                  "requiredArtifacts"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "blocking": {
                    "const": true
                  },
                  "requiredCapabilities": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "requiredArtifacts": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "name",
              "terminal"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "terminal": {
                "const": true
              }
            }
          }
        ]
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "on"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "on": {
            "enum": [
              "pass",
              "fail",
              "blocked"
            ]
          }
        }
      }
    }
  }
}
