{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "setup.schema.json",
  "title": "Guided Setup Registry Entry",
  "type": "object",
  "required": [
    "name",
    "description",
    "version",
    "mode",
    "defaultSelection",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "greenfield",
        "brownfield"
      ]
    },
    "defaultSelection": {
      "allOf": [
        {
          "$ref": "#/$defs/selection"
        },
        {
          "required": [
            "bundle",
            "targets"
          ]
        }
      ]
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "prompt",
          "defaultOption",
          "options"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "defaultOption": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "value",
                "label",
                "classification",
                "reason"
              ],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "classification": {
                  "type": "string",
                  "enum": [
                    "recommended",
                    "compatible",
                    "blocked"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "selection": {
                  "$ref": "#/$defs/selection"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "selection": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "bundle": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
