{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact.schema.json",
  "title": "Artifact Contract Registry Entry",
  "type": "object",
  "required": [
    "type",
    "version",
    "description",
    "pathPattern",
    "status",
    "provenance",
    "revision",
    "evidence",
    "statusInvariants",
    "statusSemantics",
    "allowedStatuses",
    "requiredHeadings"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "pathPattern": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "status": {
      "type": "object",
      "required": [
        "heading",
        "pattern"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "const": "## Status"
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "heading",
        "requiredIdentities"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "const": "## Provenance"
        },
        "requiredIdentities": {
          "type": "array",
          "const": [
            "artifactType",
            "artifactVersion",
            "workflow",
            "workflowVersion",
            "roleBinding",
            "agentInstance"
          ]
        }
      }
    },
    "revision": {
      "type": "object",
      "required": [
        "heading",
        "pattern"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "const": "## Revision"
        },
        "pattern": {
          "type": "string",
          "const": "^[1-9][0-9]*$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "heading",
        "requiredFields"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "const": "## Evidence"
        },
        "requiredFields": {
          "type": "array",
          "const": [
            "claim",
            "source",
            "reproduction",
            "result"
          ]
        }
      }
    },
    "statusInvariants": {
      "type": "object",
      "required": [
        "passRequiresCompleteEvidence",
        "passForbidsDemonstratedNonconformance",
        "failRequiresDemonstratedNonconformance",
        "blockedRequiresUnavailablePrerequisite"
      ],
      "additionalProperties": false,
      "properties": {
        "passRequiresCompleteEvidence": {
          "const": true
        },
        "passForbidsDemonstratedNonconformance": {
          "const": true
        },
        "failRequiresDemonstratedNonconformance": {
          "const": true
        },
        "blockedRequiresUnavailablePrerequisite": {
          "const": true
        }
      }
    },
    "statusSemantics": {
      "type": "object",
      "required": [
        "passDefinition",
        "failDefinition",
        "blockedDefinition",
        "mixedConditionRule"
      ],
      "additionalProperties": false,
      "properties": {
        "passDefinition": {
          "type": "string",
          "minLength": 1
        },
        "failDefinition": {
          "type": "string",
          "minLength": 1
        },
        "blockedDefinition": {
          "type": "string",
          "minLength": 1
        },
        "mixedConditionRule": {
          "type": "string",
          "const": "FAIL_ON_DEMONSTRATED_NONCONFORMANCE"
        }
      }
    },
    "allowedStatuses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "requiredHeadings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
